---
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pageUrl = (path = '') => `${base}${path.replace(/^\/+/, '')}`;

const links = [
  { href: pageUrl(), label: 'Home' },
  { href: pageUrl('about'), label: 'About' },
  { href: pageUrl('projects'), label: 'Projects' },
  { href: pageUrl('blog'), label: 'Blog' },
  { href: pageUrl('contact'), label: 'Contact' },
];

const normalizedPathname = pathname.replace(/\/+$/, '') || '/';
const isActive = (href) => {
  const normalizedHref = href.replace(/\/+$/, '') || '/';
  return normalizedHref === (base.replace(/\/+$/, '') || '/')
    ? normalizedPathname === normalizedHref
    : normalizedPathname === normalizedHref || normalizedPathname.startsWith(`${normalizedHref}/`);
};
---

<header class="site-header">
  <a class="wordmark" href={pageUrl()} aria-label="Anirudh Bompada — home">
    <span class="wordmark-mark" aria-hidden="true">AB</span>
    <span class="wordmark-name">Anirudh Bompada</span>
  </a>

  <nav aria-label="Primary navigation">
    <ul class="nav-list">
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
