  <div class="footer-links">
    <a href="https://github.com/anirudh-bompada" target="_blank" rel="noreferrer">
      GitHub<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a href={contactUrl}>Contact</a>
  </div>
</footer>
