---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Anirudh Bompada"
  description="Connect with Anirudh Bompada through GitHub."
>
  <section class="page-hero">
    <p class="eyebrow">Contact</p>
    <h1>Let’s connect through <span class="accent">the work.</span></h1>
    <p class="page-intro">
      GitHub is currently the best place to follow my public projects and start a technical
      conversation.
    </p>
  </section>

  <section class="contact-panel">
    <div>
      <p class="meta-label">Public profile</p>
      <h2>anirudh-bompada</h2>
      <p>
        This site and the projects behind it are being built in public, one measured step at a
        time.
      </p>
    </div>
    <a
      class="button"
      href="https://github.com/anirudh-bompada"
      target="_blank"
      rel="noreferrer"
    >
      Open GitHub<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </section>
</BaseLayout>
