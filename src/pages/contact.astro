---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const projectsUrl = `${base}projects`;
---

<BaseLayout
  title="Contact — Anirudh Bompada"
  description="Contact information for Anirudh Bompada's personal site is not publicly listed."
>
  <section class="page-hero">
    <p class="eyebrow">Contact</p>
    <h1>Sharing the work, <span class="accent">keeping details private.</span></h1>
    <p class="page-intro">
      This site does not publish personal contact information or a direct contact method.
      You can explore the public technical work here in the meantime.
    </p>
  </section>

  <section class="contact-panel">
    <div>
      <p class="meta-label">Contact status</p>
      <h2>No contact details listed</h2>
      <p>
        I have chosen not to post an email address, phone number, or profile link here.
        A public contact option can be added later if I decide to make one available.
      </p>
    </div>
    <a class="button" href={projectsUrl}>Explore projects</a>
  </section>
</BaseLayout>
