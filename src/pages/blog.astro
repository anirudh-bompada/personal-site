---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const projectsUrl = `${base}projects`;
---

<BaseLayout
  title="Blog — Anirudh Bompada"
  description="Technical notes from Anirudh Bompada on data engineering, cloud systems, and local AI."
>
  <section class="page-hero">
    <p class="eyebrow">Blog</p>
    <h1>Notes worth <span class="accent">reusing.</span></h1>
    <p class="page-intro">
      A home for technical explanations, benchmark findings, and lessons that become clearer
      through writing.
    </p>
  </section>

  <section class="empty-state">
    <div>
      <p class="eyebrow">Publication queue / empty</p>
      <h2>No articles published yet.</h2>
      <p>
        The structure is ready. The first entries will appear here when they are ready to be
        useful—not simply to fill the page.
      </p>
    </div>
    <a class="button secondary" href={projectsUrl}>Explore projects</a>
  </section>
</BaseLayout>
