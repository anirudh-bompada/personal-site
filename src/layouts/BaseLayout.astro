---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Anirudh Bompada — Data Engineer',
  description = 'Data engineering, cloud systems, and practical local AI experiments by Anirudh Bompada.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const faviconUrl = `${base}favicon.svg`;
const sitemapUrl = new URL(`${base}sitemap.xml`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071019" />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anirudh Bompada" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>{title}</title>
    <!-- Cookie-free analytics, restricted to the production domain. -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="0cf88742-cb3b-4f31-add9-c10b97eb398b"
      data-domains="anirudhbompada.com"
      data-exclude-search="true"
      data-exclude-hash="true"
      data-do-not-track="true"
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page-shell">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
